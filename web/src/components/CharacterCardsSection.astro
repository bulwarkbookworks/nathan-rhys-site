---
import { PortableText } from 'astro-portabletext';

interface Props {
  section: any;
}

const { section } = Astro.props;
---

<div class="character-cards-section-wrapper">
  {section.beforeContent && (
    <div class="rich-text-content mb-10">
      <PortableText value={section.beforeContent} />
    </div>
  )}

  <div class="character-cards-grid grid gap-8 md:grid-cols-2 lg:grid-cols-3">
    {section.cards?.map((card: any) => (
      <div class="character-card">
        <h3 class="character-card__name">{card.name}</h3>
        {card.descriptor && (
          <p class="character-card__descriptor">{card.descriptor}</p>
        )}
        {card.introduction && (
          <div class="character-card__introduction rich-text-content">
            <PortableText value={card.introduction} />
          </div>
        )}
      </div>
    ))}
  </div>

  {section.afterContent && (
    <div class="rich-text-content mt-10">
      <PortableText value={section.afterContent} />
    </div>
  )}
</div>

<style>
  .character-card {
    padding: 1.5rem;
    border: 1px solid color-mix(in srgb, var(--color-secondary) 20%, transparent);
    border-radius: 0.5rem;
    background-color: var(--color-surface-soft, transparent);
  }

  .character-card__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin-top: 0;
    margin-bottom: 0.25rem;
    color: var(--color-text-main);
  }

  .character-card__descriptor {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-top: 0;
    margin-bottom: 1rem;
    font-style: italic;
  }

  .character-card__introduction {
    font-size: 1rem;
  }
</style>
